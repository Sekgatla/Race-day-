@using RaceDay.Contracts
@using RaceDay.Mvc.Services
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · RaceDay</title>
    <meta name="description" content="Find South African road events, enter races, and follow every finish." />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700;800&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var role = Context.Session.GetString(SessionKeys.Role);
        var userName = Context.Session.GetString(SessionKeys.Name);
        var isSignedIn = !string.IsNullOrWhiteSpace(role);
    }
    <header class="site-header">
        <nav class="navbar navbar-expand-lg navbar-dark">
            <div class="container-xl">
                <a class="navbar-brand raceday-brand" asp-controller="Home" asp-action="Index" aria-label="RaceDay home">
                    <span class="brand-mark">R</span>
                    <span>RACEDAY<span class="brand-period">.</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <div class="navbar-nav me-auto">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Find events</a>
                        @if (role == RaceDayRoles.Organiser)
                        {
                            <a class="nav-link" asp-controller="Organiser" asp-action="Index">Organiser dashboard</a>
                        }
                        @if (role == RaceDayRoles.Participant)
                        {
                            <a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">My entries</a>
                            <a class="nav-link" asp-controller="Participant" asp-action="MyResults">My results</a>
                        }
                    </div>
                    <div class="navbar-nav align-items-lg-center gap-lg-2">
                        @if (isSignedIn)
                        {
                            @if (role == RaceDayRoles.Participant)
                            {
                                <a class="nav-link profile-link" asp-controller="Participant" asp-action="Profile">
                                    <span class="profile-dot">@userName?.FirstOrDefault()</span>@userName
                                </a>
                            }
                            else
                            {
                                <span class="nav-link user-name">@userName</span>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-light btn-sm nav-logout" type="submit">Sign out</button>
                            </form>
                        }
                        else
                        {
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a>
                            <a class="btn btn-lime btn-sm nav-join" asp-controller="Account" asp-action="Register">Join RaceDay</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main>
        <div class="container-xl flash-wrap">
            @if (TempData["Success"] is string success)
            {
                <div class="alert alert-success alert-dismissible fade show" role="status">
                    @success
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert alert-warning alert-dismissible fade show" role="alert">
                    @error
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </div>
    </main>

    <footer class="site-footer">
        <div class="container-xl d-flex flex-column flex-md-row justify-content-between gap-2">
            <span><strong>RACEDAY.</strong> Built for every road, every finish.</span>
            <span>South Africa · Run · Walk · Cycle</span>
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
