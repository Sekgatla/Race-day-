@model IReadOnlyList<EnrolmentDto>
@{
    ViewData["Title"] = "My entries";
}
<div class="page-heading">
    <div><p class="eyebrow">YOUR RACE CALENDAR</p><h1>My entries</h1></div>
    <a asp-controller="Home" asp-action="Index" class="btn btn-lime">Find an event <span aria-hidden="true">↗</span></a>
</div>
@if (Model.Count == 0)
{
    <div class="empty-panel mb-5">
        <h2 class="h3 text-uppercase">Your next start is waiting</h2>
        <p class="text-secondary">Once you enter an event, it will appear here with your category and entry status.</p>
        <a asp-controller="Home" asp-action="Index" class="btn btn-dark">Browse events</a>
    </div>
}
else
{
    <div class="organiser-table-wrap table-responsive mb-5">
        <table class="table table-hover align-middle">
            <thead><tr><th>Event</th><th>Category</th><th>Entry date</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var entry in Model.OrderByDescending(x => x.EnrolmentDate))
            {
                var statusClass = entry.EnrolmentStatus.ToLowerInvariant() switch { "confirmed" => "status-confirmed", "pending" => "status-pending", _ => "status-withdrawn" };
                <tr>
                    <td><strong>@entry.EventName</strong><div class="small text-secondary">Bib @(entry.BibNumber?.ToString() ?? "pending")</div></td>
                    <td>@entry.CategoryName</td>
                    <td>@entry.EnrolmentDate.ToString("dd MMM yyyy")</td>
                    <td><span class="status-pill @statusClass">@entry.EnrolmentStatus</span></td>
                    <td><a asp-controller="Events" asp-action="Details" asp-route-id="@entry.EventId" class="arrow-link">Details ↗</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
