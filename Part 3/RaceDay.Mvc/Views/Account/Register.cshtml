@model RegisterViewModel
@{
    ViewData["Title"] = "Create an account";
}
<section class="auth-shell">
    <aside class="auth-aside">
        <div>
            <p class="eyebrow">FIND YOUR PACE</p>
            <h1>Be there<br />for the <em>start.</em></h1>
            <p>One account connects you to community races, personal results, and every finish still to come.</p>
        </div>
        <span class="auth-aside-foot">RUN · WALK · CYCLE</span>
    </aside>
    <div class="auth-form">
        <h2>Join RaceDay</h2>
        <p>Create your account to get started.</p>
        <div asp-validation-summary="ModelOnly" class="mb-3"></div>
        <form asp-action="Register" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-sm-6">
                    <label asp-for="FirstName" class="form-label">First name</label>
                    <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
                    <span asp-validation-for="FirstName"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="LastName" class="form-label">Last name</label>
                    <input asp-for="LastName" class="form-control" autocomplete="family-name" />
                    <span asp-validation-for="LastName"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Email" class="form-label">Email address</label>
                    <input asp-for="Email" class="form-control" autocomplete="email" />
                    <span asp-validation-for="Email"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Password" class="form-label">Password <small class="text-secondary">(10 characters minimum)</small></label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password"></span>
                </div>
                <div class="col-sm-6">
                    <label asp-for="Role" class="form-label">I am a</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Participant">Participant</option>
                        <option value="Organiser">Event organiser</option>
                    </select>
                </div>
                <div class="col-sm-6">
                    <label asp-for="PhoneNumber" class="form-label">Phone <small class="text-secondary">(optional)</small></label>
                    <input asp-for="PhoneNumber" class="form-control" autocomplete="tel" />
                    <span asp-validation-for="PhoneNumber"></span>
                </div>
            </div>
            <button class="btn btn-lime w-100 mt-4" type="submit">Create account <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-foot">Already have an account? <a asp-action="Login">Sign in</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
